# Cuenta de pruebas contra el stack de desarrollo (Playwright, agentes, curl).
# No se edita a mano: `make e2e-usuario` crea la cuenta y escribe .env.e2e.local
# (fuera de git) con estas variables. `make e2e-token` da un Bearer para la API.
E2E_BASE_URL=https://localhost
E2E_ADMIN_USER=pruebas
E2E_ADMIN_PASSWORD=
