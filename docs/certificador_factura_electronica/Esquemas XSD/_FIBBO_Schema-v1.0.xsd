                    <xs:element name="DepartamentoCompra" type="xs:string" />
                    <xs:element name="IdPedido" type="xs:string" />
                    <xs:element name="FechaOrden" type="xs:date" />
                  </xs:sequence>
                  <xs:attribute name="consec" type="xs:unsignedByte" use="required" />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="DiasCredito" type="xs:unsignedByte" />
        <xs:element name="CodigoVendedor" type="xs:string" />
        <xs:element name="CodigoProyecto" type="xs:string" />
        <xs:element name="FechaRecepcion" type="xs:date" />
        <xs:element name="ContactoRecepcion" type="xs:string" />
      </xs:sequence>
      <xs:attribute name="version" type="xs:decimal" use="required" />
    </xs:complexType>
  </xs:element>
