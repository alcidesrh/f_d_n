{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('reserva') }}
{% endblock %}

{% block javascripts %}
	<script data-turbo="false" type="text/javascript" src="https://h.online-metrix.net/fp/tags.js?org_id={{org_id}}&session_id={{cybersource_session_id}}"></script>
	{{ parent() }}
{% endblock %}

{% block seo %}
	{{ sonata_seo_metadatas() }}
{% endblock %}

{% block body %}

	<div class="relative flex justify-center items-center banner z-40">


		<div id="reserva-wrap" class="transferencia bg-sky-800 mx-auto mt-5 min-w-min max-w-5xl shadow-lg w-full m-auto px-0 lg:px-16 pt-5 pb-0 lg:py-10">

			<div data-controller="transferencia">

				<div class="reserva-form-wrap bg-white  min-h-[180px] mt-3">
					<div class="flex items-center justify-center w-full relative px-0 sm:px-10 md:px-6 lg:px-12 pb-10 sm:py-10 md:pt-0 mt-0 lg:pt-5  border-none sm:lg:border-2 border-sky-600">
						<div class="w-full">

							{% include 'reservacion/_transferencia.html.twig' %}

						</div>
					</div>
				</div>
			</div>
		</div>

	</div>

	<div id="turbo-loading">
		{{ component('alert', {attr: 'id=msg-pagando', class: 'm-1 py-5 rounded-lg border-l-0 my-0 info max-w-sm sm:max-w-lg bg-sky-600 text-white !text-base border-l-0',  icon_class: 'fill-white',  text: 'Este proceso puede tardar varios segundos. Por favor mantegase en la página.' | trans}) }}

		<svg class="w-24" version="1.1" id="L4" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewbox="0 0 100 100" enable-background="new 0 0 0 0" xml:space="preserve">
			<circle fill="#3D92B2" stroke="none" cx="6" cy="50" r="6">
				<animate attributename="opacity" dur="1s" values="0;1;0" repeatcount="indefinite" begin="0.1"></animate>
			</circle>
			<circle fill="#3D92B2" stroke="none" cx="26" cy="50" r="6">
				<animate attributename="opacity" dur="1s" values="0;1;0" repeatcount="indefinite" begin="0.2"></animate>
			</circle>
			<circle fill="#3D92B2" stroke="none" cx="46" cy="50" r="6">
				<animate attributename="opacity" dur="1s" values="0;1;0" repeatcount="indefinite" begin="0.3"></animate>
			</circle>
			<circle fill="#3D92B2" stroke="none" cx="66" cy="50" r="6">
				<animate attributename="opacity" dur="1s" values="0;1;0" repeatcount="indefinite" begin="0.3"></animate>
			</circle>
			<circle fill="#3D92B2" stroke="none" cx="86" cy="50" r="6">
				<animate attributename="opacity" dur="1s" values="0;1;0" repeatcount="indefinite" begin="0.3"></animate>
			</circle>
		</svg>
	</div>
{% endblock %}
