{% form_theme form.tarjeta 'form/theme/_tarjeta_label.html.twig' %}


<div class="alert text-base mt-0 relative border-l-4" role="alert">
	<div class="flex relative items-center">
		<span class="grid">
			<span class="relative flex items-center gap-3">

				<div class="relative flex">
					<div>
						{{'No guardamos ningún dato de la tarjeta. Garantizamos su seguridad a travez de' | trans}}
						<b>3D Security Protocol</b>
					</div>

				</div>
			</span>
		</span>
	</div>
</div>

<div class="grid child-form-y-space ">

	<div class="grid child-form-y-space">
		<div
			class="flex !mt-0">
			{# {{ form_row(form.precio_visual, {row_attr: {class: 'mb-0'}, attr: {class: 'max-w-[130px]'}})}} #}
			<div class="form-row mb-0">
				<label class="form-label asteric required" for="pago_datos_precio_visual">{{form.precio_visual.vars.label}}</label>

				<div class="p-1 px-3 w-full border border-slate-300">
					<span data-pagar-target='precio'>{{form.precio_visual.vars.data}}</span>
				</div>
			</div>
			{{ form_row(form.moneda, { row_attr: {class: 'mb-0'}, attr: {class: 'flex gap-5'}, row_attr:{class: 'ml-8'}})}}
		</div>
	</div>

	<div class=" mt-10 mb-6">
		<span class=" font-medium text-lg">{{'Tarjeta de crédito' | trans}}</span>
	</div>

	<div class="!mt-0">
		{{ form_row(form.tarjeta, { attr: {class: 'tarjeta break-all grid grid-cols-2 sm:grid-cols-3 gap-3 lg:max-w-2xl'}})}}
	</div>


	<div class="flex flex-wrap child-form-y-space">

		<div class="basis-full sm:flex !mt-0">
			{{ form_row(form.numero, {row_attr: {class: 'basis-full md:basis-3/4 xl:bassis-3/5'}})}}
		</div>

		<div class="basis-1/2 sm:basis-1/3 md:basis-1/4 xl:bsasis-1/5 pr-2 md:pr-3">
			{{ form_row(form.expira_mes)}}
		</div>

		<div class="basis-1/2 sm:basis-1/3 md:basis-1/4 xl:bsasis-1/5 pl-2 sm:px-2 md:px-3">
			{{ form_row(form.expira_year)}}
		</div>

		<div class="basis-1/2 sm:basis-1/3 md:basis-1/4 xls:basis-1/5 pl-0 sm:pl-2 md:pl-3">
			{{ form_row(form.codigo_seguridad)}}
		</div>

	</div>
