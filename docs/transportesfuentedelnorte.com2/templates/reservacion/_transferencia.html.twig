<turbo-frame id="reservacion-form">

	<div data-controller="transferencia" class="mt-14 sm:mt-36 lg:mt-10 px-5 pb-32 sm:pb-0">

		{% if completada is defined %}
			<div class="mb-5 h-72 flex justify-center items-center">
				{{ component('alert', {class: 'info', icon: 'done', text: ('La transferencia ha sido realizada con éxitos' | trans) }) }}
			</div>
		{% else %}
			{% from 'email/macros.html.twig' import error_alert %}

			{% if error %}

				{{ error_alert( error ) }}

			{% endif %}


			{{ form_start(form, {attr:{id: 'form-pagar', 'data-action': "pagar#onSubmit", 'data-pagar': true}})}}

			<div class="min-w-fit lg:min-w-[750px]">

				<div class="w-fit m-auto max-w-lg sm:max-w-[600px] md:max-w-2xl">

					{% include 'reservacion/_pago_datos.html.twig' with {transferencia: true,} %}

					<div class="divide dashed"></div>

					<div>
						<span class="max-w-xs pb-2 font-semibold text-lg border-bottom text-slate-700">{{'Propietario de la tarjeta' | trans}}</span>
					</div>


					{% include 'reservacion/_form_cliente_reservacion.html.twig' %}

				</div>

			</div>

			<div class="hidden sm:flex justify-between sm:justify-center gap-0 sm:gap-8 m-auto mt-14 max-w-lg sm:max-w-[600px] md:max-w-2xl lg:max-w-5xl">
				{{ component('button', {text: 'Pagar' | trans, icon: {left: true, name: 'payments'}, attr: {'type': 'submit'}}) }}
			</div>


			<div class="fixed-buttons">
				{{ component('button', {text: 'Pagar' | trans, class: 'z-10 py-2', icon: {left: true, name: 'payments'}, attr: {'type': 'submit'}}) }}
			</div>


			{{ form_end(form) }}

			<div id="data-collection" {{ turbo_stream_listen('data_collection_iframe_' ~ app.session.id) }}></div>
		{% endif %}

	</div>
</turbo-frame>
