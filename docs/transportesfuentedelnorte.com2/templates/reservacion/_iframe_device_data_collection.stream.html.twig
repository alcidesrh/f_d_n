<turbo-stream action="update" target="data-collection">
	<template>

		<div data-turbo="false" data-turbo-cache="false" data-controller='data-collection-iframe' data-data-collection-iframe-payer-authentication-check-enrollment-url-value="{{path('payer_authentication_check_enrollment', {session_id_challenge_response: app.session.id})}}" data-data-collection-iframe-error-server-sent-event-url-value="{{path('payment_iframe_data_collection_error')}}" data-data-collection-iframe-allowed-origins-value="{{ cybersource_trusted_origins|json_encode|e('html_attr') }}">
			<iframe name="ddc-iframe" height="10" width="10" style="display: none;"></iframe>
			<form data-data-collection-iframe-target='form' data-turbo="false" id="ddc-form" target="ddc-iframe" method="POST" action="{{deviceDataCollectionUrl}}">
				<input type="hidden" name="JWT" value="{{accessToken}}"/>
			</form>
		</div>
		<script data-turbo="false">
			console.log("[CyberSource | Visa] Servidor -> DDC iframe | deviceDataCollectionUrl:", {{ deviceDataCollectionUrl|json_encode|raw }});
			console.log("[CyberSource | Visa] Servidor -> DDC iframe | JWT (accessToken):", {{ accessToken|json_encode|raw }});
			console.log("[CyberSource | Visa] Servidor -> DDC iframe | allowedOrigins:", {{ cybersource_trusted_origins|json_encode|raw }});
			console.log("[CyberSource | Visa] Servidor -> DDC iframe | referenceId:", {{ app.session.get('referenceId')|json_encode|raw }});
		</script>

	</template>
</turbo-stream>
