<div class="!mt-16 mb-6">
	<span class=" font-medium text-lg">{{'Propietario de la tarjeta' | trans}}</span>
</div>


<div class="grid sm:grid-cols-2 gap-x-5 child-form-y-space !mt-0">

	{{ form_row(form.cliente.nombre, {row_attr:{class: '!mt-0'}})}}


	{{ form_row(form.cliente.apellido, {row_attr:{class: 'sm:!mt-0'}})}}


	{{ form_row(form.cliente.pais)}}


	<turbo-frame id="provincia-frame" data-provincias-ruta="{{path('provincias_transferencia')}}">
		{{ form_row(form.cliente.provincia)}}
	</turbo-frame>

	<turbo-frame id="ciudad-frame" data-municipios-ruta="{{path('ciudad_transferencia')}}">
		{{ form_row(form.cliente.ciudad)}}
	</turbo-frame>


	<div class="grid sm:grid-cols-2 gap-x-5 sm:col-span-2 !mt-0 child-form-y-space ">
		{{ form_row(form.cliente.email)}}
		{{ form_row(form.cliente.telefono)}}
	</div>

	{{ form_row(form.cliente.direccion, {row_attr:{class: 'sm:w-[75%]'}})}}


</div>
