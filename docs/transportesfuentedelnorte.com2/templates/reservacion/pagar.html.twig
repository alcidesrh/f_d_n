<turbo-frame id="reservacion-form">

	<div class="mt-0 sm:mt-36 md:mt-16 lg:mt-10 px-0 sm:pb-0">

		{% from 'email/macros.html.twig' import error_alert %}

		{% if error %}

			{{ error_alert( error ) }}

		{% endif %}

		{{ form_start(form, {attr:{id: 'form-pagar', 'data-action': "pagar#onSubmit", 'data-pagar': true, 'data-controller': 'pagar'}})}}

		<div class="min-w-fit lg:min-w-[750px]">

			<div class="w-fit m-auto max-w-lg sm:max-w-[600px] md:max-w-2xl">

			<div id="error_pago" {{ turbo_stream_listen('error_pago_' ~ app.session.id) }}></div>

				{% include 'reservacion/_reservacion_resumen.html.twig' %}

				{% include 'reservacion/_pago_datos.html.twig' %}

				{% include 'reservacion/_form_cliente_reservacion.html.twig' %}

				

				<div class="grid child-form-y-space !mt-10">
					<div class=" !mt-0 p-4 px-6 bg-teal-50/60 text-sky-900 border text-base border-sky-400 font-medium">
						<div class="mb-2 text-lg font-semibold">{{"Importante" | trans}}:</div>
						<div>
							<strong>1. -</strong>
							{{'La factura saldrá a nombre de' | trans }}:
							<strong data-pagar-target="nombre_factura_alert"></strong>
						</div>
						<div>
							<strong>2. -</strong>
							{{'Puede cambiarlo escribiendo otro o escribiendo en el cadro de abajo un Nit que nuestro sistema usará para obtener de la Sat el nombre de la empresa o persona asociado a ese Nit.' | trans}}

						</div>
					</div>

					<div class="!mt-7 sm:w-[75%]">
						{{ form_row(form.cliente.nombre_factura)}}
					</div>


					<div class="flex !mt-5 font-medium items-center">
						{{ form_row(form.cliente.nit, {attr: {class: 'w-28 mr-4' ,placeholder: 'Nit'}})}} Nit ({{'opcional' | trans}})

						{# {{ component('button', {text: 'Buscar Nit' | trans, attr: {type: 'button', id: 'salida_submit', 'data-action': 'pagar#buscarNit' }, class: 'sm'}) }} #}
					</div>

					<div class="max-w-sm !mt-2 p-2 px-4 bg-red-50/60 border border-red-300 text-red-700 text-sm hidden break-words" data-pagar-target="nit_error"></div>


				</div>

				<div class="font-medium flex">
					{{'Al realizar el pago usted está aceptando nuestros' | trans}}

					<a class="ml-2 !underline font-semibold text-sky-700" target="_blank" href="{{path('politica')}}">
						<em>{{'Términos & Condiciones' | trans}}</em>
					</a>
				</div>

				<div class="hidden sm:flex justify-between sm:justify-center gap-0 sm:gap-8 m-auto mt-14 max-w-lg sm:max-w-[600px] md:max-w-2xl lg:max-w-5xl">
					{{ component('button_link', {text: 'Atrás' | trans, icon: {left: true, name: 'arrow_back'}, link: path('asientos', {'reservacion': reservacion.id})}) }}
					{{ component('button_link', {text: 'Cancelar' | trans, icon: {left: true, name: 'block'}, link: path('reiniciar'), attr: 'data-turbo=false'}) }}
					{{ component('button', {text: 'Pagar' | trans, icon: {left: true, name: 'payments'}, attr: {'type': 'button', 'data-action': "pagar#validarNit"}, class: 'bg-sky-600 text-white border-blue-300  hover:bg-blue-700'}) }}

				</div>


				<div class="fixed-buttons">
					<div class="m-auto flex w-full justify-around py-3 z-20 relative">
						{{ component('button_link', {text: 'Atrás' | trans,  icon: {left: true, name: 'arrow_back'}, link: path('asientos', {'reservacion': reservacion.id})}) }}
						{{ component('button_link', {text: 'Cancelar' | trans, icon: {left: true, name: 'block'}, link: path('reiniciar'), attr: 'data-turbo=false'}) }}
						{{ component('button', {text: 'Pagar' | trans, icon: {left: true, name: 'payments', class_icon: 'mr-[4px]'}, attr: {'type': 'button', 'data-action': "pagar#validarNit"}, class: 'bg-sky-600 text-white border-blue-300 !hover:bg-sky-600'}) }}


					</div>
					<div class="bg-button-reserva"></div>

				</div>


				<div id="data-collection" {{ turbo_stream_listen('data_collection_iframe_' ~ app.session.id) }}></div>
			</div>
		</div>

		{{ form_end(form) }}

	</div>
</turbo-frame>
