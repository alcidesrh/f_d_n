<div class=" flex px-1 sm:px-3 z-30 relative" data-reservacion-target="pasos">


	<div class="w-1/4 {{ paso_completado == 0 ? 'active' : 'complete'}}">
		<div class="relative mb-2">
			<div class="step-label">
				<span>{{ 'Destino'|trans }}</span>
			</div>
			<div class="step-icon capitalize">
				<span class="material-symbols-outlined">
					sync_alt
				</span>
			</div>


		</div>
	</div>

	<div class="w-1/4 {{ paso_completado == 1 ? 'active' : (paso_completado > 1 ? 'complete' : '') }}">
		<div class="relative">
			<div class="step-label">
				<span>{{'Fecha'|trans}}</span>
			</div>
			<div class="absolute bottom-0 mb-3 flex align-center items-center align-middle content-center" style="width: calc(100% - 2.5rem - 1rem); transform: translate(-50%, -50%)">
				<div class="w-full rounded items-center align-middle align-center flex-1">
					<div class="step-union-lines"></div>
				</div>
			</div>
			<div class="step-icon">
				<span class="material-symbols-outlined">
					schedule
				</span>
			</div>

		</div>
	</div>

	<div class="w-1/4 {{ paso_completado == 2 ? 'active' : (paso_completado > 2 ? 'complete' : '') }}">
		<div class="relative">
			<div class="step-label">
				<span>{{'Asientos'|trans}}</span>
			</div>
			<div class="absolute bottom-0 mb-3  flex align-center items-center align-middle content-center" style="width: calc(100% - 2.5rem - 1rem);transform: translate(-50%, -50%)">
				<div class="w-full rounded items-center align-middle align-center flex-1">
					<div class="step-union-lines"></div>
				</div>
			</div>

			<div class="step-icon">
				<span class="material-symbols-outlined">
					airline_seat_recline_extra
				</span>
			</div>
		</div>
	</div>

	<div class="w-1/4 {{ paso_completado == 3 ? 'active' : (paso_completado > 3 ? 'complete' : '') }}">
		<div class="relative">
			<div class="step-label">
				<span>
					{{'Pagar'|trans}}
				</span>
			</div>

			<div class="absolute bottom-0 mb-3 flex align-center items-center align-middle content-center" style="width: calc(100% - 2.5rem - 1rem);transform: translate(-50%, -50%)">
				<div class="w-full rounded items-center align-middle align-center flex-1">
					<div class="step-union-lines"></div>
				</div>
			</div>

			<div class="step-icon">
				<span class="material-symbols-outlined">
					credit_card
				</span>
			</div>
		</div>
	</div>

</div>
