<turbo-stream action="update" target="error_generico">
	<template>
		<div class="text-center my-5" id="error_generico">
			{% if detalle is defined and detalle %}
				{% set error = (error | trans) ~ '<br/>' ~ ('Respuesta recibida' | trans) ~ ': <span class="font-semibold">"' ~ detalle ~ '"</span>' %}
			{% endif %}
			{{ component('alert', {icon: 'error', text: error | trans, class: 'mb-0 error'}) }}
		</div>
	</template>
</turbo-stream>
