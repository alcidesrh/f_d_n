<div class="alert info text-base  relative border-x-4 my-3" role="alert">
	<div class="flex relative items-center">
		<span class="grid">
			<span class="relative flex items-center gap-3">
				<div class="relative flex">
					<div>
						{{'Por favor compruebe que los datos sean correctos antes de realizar el pago' | trans}}
					</div>
				</div>
			</span>
		</span>
	</div>
</div>


<div class="grid grid-cols-1 gap-x-3 !mt-5 {{ reservacion.isIdaVuelta ?'md:grid-cols-2'}}">

	{% for salida_tipo, salida_reservacion in reservacion.getSalidasArray  %}

		<div class="p-5 bg-slate-200  rounded h-full">

			<div class="flex justify-center mb-5">
				{% if( reservacion.isIdaVuelta ) %}
					<div class="px-3 py-2 b border-t-0 border-r-0 rounded-bl-lg rounded-br-lg border-dashed">
						<span class="font-bold">
							{{ ( salida_tipo == 'salida' ? 'Viaje de ida' : 'Viaje de vuelta') | trans}}
						</span>
					</div>
				{% endif %}
			</div>

			<div class="reservacion_detalle_row">
				<span class="flex justify-end ">
					<span class="hora">{{'Hora' | trans}}</span>
				</span>
				<span class="material-symbols-outlined">
					arrow_right_alt
				</span>
				<span class="bg-slate-700 p-2 hora-data">{{ reservacion.getSalidaFacturaFecha(salida_tipo, 'hora')}}</span>
			</div>

			<div class="reservacion_detalle_row">
				<span class="flex justify-end">
					<span class="dia">{{'Día' | trans}}</span>
				</span>
				<span class="material-symbols-outlined">
					arrow_right_alt
				</span>
				<span class=" p-2 dia-data">
					{{reservacion.getSalidaFacturaFecha(salida_tipo, 'fecha')}}</span>
			</div>

			<div class="reservacion_detalle_row">
				<span class="flex justify-end">
					<span>{{'Asientos' | trans}}</span>
				</span>
				<span class="material-symbols-outlined">
					arrow_right_alt
				</span>

				<span class="p-2 px-4">
					{% for asiento in salida_tipo != 'salida' ? reservacion.regreso.asientos : reservacion.salida.asientos %}
						{{ asiento.numero}}{{not loop.last ? ', '}}
					{% endfor %}
				</span>
			</div>

			{% if( salida_tipo == 'salida' ) %}


				<div class="reservacion_detalle_row">
					<span class="flex justify-end">
						<span>{{'Salida' | trans}}</span>
					</span>
					<span class="material-symbols-outlined">
						arrow_right_alt
					</span>
					<span class="p-2 px-4">
						{{reservacion.ruta.getEstacionSalida.nombre ~ '.   ' ~ reservacion.ruta.getEstacionSalida.direccion}}
					</span>
				</div>

				<div class="reservacion_detalle_row">
					<span class="flex justify-end">
						<span>{{'Arrivo' | trans}}</span>
					</span>
					<span class="material-symbols-outlined">
						arrow_right_alt
					</span>
					<span class=" p-2">
						{{reservacion.ruta.getEstacionLlegada.nombre ~ '.   ' ~ reservacion.ruta.getEstacionLlegada.direccion}}</span>
				</div>

				<div class="grid mt-8 font-medium text-sm">

					<span class="mb-1 text-base">
						{{'Salida información adicional:'   | trans}}
					</span>
					<span>
						{{ form_row(form.notaClienteSalida, {row_attr:{class: 'sm:!mt-0'}})}}

					</span>
					<span class="text-xs font-semibold">

						{{'Información adicional que quiera dejar. Por ejemplo donde abordará el bus, o si necesita espacio para equipaje. etc... '   | trans}}
					</span>
				</div>


			{% else %}


				<div class="reservacion_detalle_row">
					<span class="flex justify-end">
						<span>{{'Salida' | trans}}</span>
					</span>
					<span class="material-symbols-outlined">
						arrow_right_alt
					</span>
					<span>
						{{reservacion.ruta.getEstacionLlegada.nombre ~ '.   ' ~ reservacion.ruta.getEstacionLlegada.direccion}}
					</span>
				</div>

				<div class="reservacion_detalle_row">
					<span class="flex justify-end">
						<span>{{'Arrivo' | trans}}</span>
					</span>
					<span class="material-symbols-outlined">
						arrow_right_alt
					</span>
					<span>
						{{reservacion.ruta.getEstacionSalida.nombre ~ '.   ' ~ reservacion.ruta.getEstacionSalida.direccion}}</span>
				</div>

				<div class="grid mt-8 font-medium text-sm">

					<span class="mb-1 text-base">
						{{'Regreso información adicional'   | trans}}

					</span>
					<span>
						{{ form_row(form.notaClienteRegreso, {row_attr:{class: 'sm:!mt-0'}})}}
					</span>
					<span class="text-xs  font-semibold">

						{{'Información adicional que quiera dejar. Por ejemplo donde abordará el bus, o si necesita espacio para equipaje. etc... '   | trans}}
					</span>
				</div>
			{% endif %}
		</div>
	{% endfor %}
</div>
