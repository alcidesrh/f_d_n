<div {{attr}} class="alert {{class}}" role="alert">

	<div class="relative  overflow-auto">

		<div class="flex">

			<span class="material-symbols-outlined text-xl w-6 mr-1 mt-[-2px]  {{icon_class}}">
				{{icon}}
			</span>
			<p class="break-words max-w-[250px] sm:max-w-sm md:max-w-lg">
				{{text | raw}}
			</p>
		</div>
	</div>

</div>
