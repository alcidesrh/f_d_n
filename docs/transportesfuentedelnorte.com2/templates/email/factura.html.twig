				<thead>
					<th style=" padding: 7px 10px;  box-sizing: inherit;  width: 140px; text-align: left;">{{'Regreso' | trans}}:</th>
					<th></th>
				</thead>
				<tbody>
					{{ reservacion_pdf_salida(reservacion, true) }}
				</tbody>
			</table>
		{% endif %}
		{% if factura.dte is defined %}
