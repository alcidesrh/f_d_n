{% extends 'email/email_base.html.twig' %}

{% block body %}

	{% set factura = reservacion.factura %}
	{% from 'email/macros.html.twig' import reservacion_pdf_salida %}
	<body style="font-size: 14px; margin: 0; width: 100%; padding: 0; word-break: break-word; -webkit-font-smoothing: antialiased; {% if boleto_path is defined %}background-color: #E2E8F0{% endif %}">

		{% if boleto_path is defined %}
			<table align="center" style="width: 600px" cellpadding="0" cellspacing="0" role="presentation">
				<tr>
					<td style="padding: 28px; text-align: center">
						<a href="{{app.request.getSchemeAndHttpHost}}">
							<img src="{{app.request.getSchemeAndHttpHost ~ asset('images/fdn.png')}}" width="150" alt="Your Logo" style="max-width: 100%; vertical-align: middle; line-height: 100%; border: 0; margin: auto">
						</a>
					</td>
				</tr>
			</table>
		{% endif %}

		<table style="width: 100%; font-family: Montserrat, sans-serif" cellpadding="0" cellspacing="0" role="presentation">
			<tr>
				<td align="center">
					<table style="width: {% if boleto_path is defined %} 600px {% else %} 100% {% endif %}" cellpadding="0" cellspacing="0" role="presentation">
						<tr>
							<td align="center">
								<table style="width: 100%; background: #fff; padding: 20px 5px;  margin:auto" cellpadding="0" cellspacing="0" role="presentation">
									<tr>
										<td>
											<table style="max-width: {% if boleto_path is defined %} 550px; {% else %} 100%;{% endif %} margin:auto" cellpadding="0" cellspacing="0" role="presentation">
												<tr>
													<td style="text-align: left; font-size: 14px; line-height: 24px; color: #1f2937">
														<p style="margin-top: 20; margin-bottom: 20px; text-align: center; font-size: 22px; font-weight: 600; color: #164e63">
															{{'Boleto' | trans}}
															{{reservacion.salida.empresa.getNombreComercial}}
														</p>
														<div style="text-align: center">
															<p style="display: inline-block; border-radius: 8px; border-left-width: 4px; border-color: #bae6fd; background-color: #eff6ff;  {% if boleto_path is defined %}padding: 15px 25px; {% else %} padding: 15px 25px; {% endif %} margin-top: 0px; margin-bottom: 0px; text-align: left; color: #164e63;border-left-width: 4px;">
																<strong style="font-weight: 500; font-size: 16px">{{'Guarde y muestre este boleto a la hora de abordar. Feliz viaje!' | trans}}</strong>
															</p>
														</div>

													</td>
												</tr>
											</tbody>
										</td>
									</tr>
								</table>

								<table style="margin-bottom: 32px; margin-bottom: 15px; width: 100%" cellpadding="0" cellspacing="0" role="presentation">
									<tbody>
										<tr>
											<td style=" padding: 7px 10px">
												<div style="font-size: 14px;  text-align: left; color: gray; font-weight: 700; font-style: oblique;">
													ID:
													{{reservacion.id}}
												</div>
											</td>
											<td>
												<div style="padding: 7px 10px; text-align: right;font-style: oblique; font-size: 12px; color: gray; font-weight: 700; font-style: oblique;">
													{{ "now" | date("m/d/Y g:i a") | format_datetime('long', 'medium', locale=reservacion.locale) }}
												</div>
											</td>
										</tr>

										<tr>
											<td style=" padding: 7px 10px">
												<div style="font-size: 14px;  text-align: left; color: gray; font-weight: 700; font-style: oblique;">
													{{'Boleto' | trans}}(s):
													{{reservacion.getBoletosSistemaId}}

												</div>
											</td>
											<td></td>
										</tr>

									</tbody>
								</table>

								<table style="text-align: left; margin-bottom: 20px; margin-top: 20px; width: 100%" cellpadding=" 0" cellspacing=" 0" role=" presentation">
									<tbody>
										<tr style="background-color: #EFF6FF;">
											<td style="box-sizing: inherit; width: 140px; padding: 7px 10px;">
												{{'Cliente' | trans}}:
												<b>{{ reservacion.cliente.getNombreFactura()}}</b>
											</td>
										</tr>
											<tr style="background-color: #EFF6FF;">
												<td style="box-sizing: inherit; width: 140px; padding: 7px 10px;">
									{# {% if reservacion.cliente.nit and reservacion.cliente.nit != 'CF' %} #}
													{{'Nit' | trans}}:
													<b>{{ reservacion.cliente.nit}}</b>
										{# {% endif %} #}
												</td>
											</tr>
									</tbody>
								</td>
							</td>
						</tr>
					</table>
				</td>
			</tr>
