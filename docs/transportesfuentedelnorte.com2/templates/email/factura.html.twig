		<table style="margin-bottom: 32px; width: 100%" cellpadding="0" cellspacing="0" role="presentation">
			<thead>
				<th style=" padding: 7px 10px; box-sizing: inherit; text-align: left; width: 140px;">{{'Salida' | trans}}:</th>
				<th></th>
			</thead>
			<tbody>
				{{ reservacion_pdf_salida(reservacion) }}
			</tbody>
		</table>

		{% if reservacion.isIdaVuelta %}
