# Plantilla de .env.prod.local (producción en la VPS, `make prod` / `make prod-sync`).
# cp .env.prod.dist .env.prod.local && chmod 600 .env.prod.local
# Claves: `openssl rand -hex 32` (solo letras y números: la de Postgres va dentro de DATABASE_URL).
# Una línea vacía (VAR=) pisa el valor por defecto de backend/.env: borra las que no uses.

# —— Compose ——
# Dominio con un registro A a la IP de la VPS. Caddy pide el certificado de Let's Encrypt solo.
SERVER_NAME=fdn.transportesfuentedelnorte.com
APP_SECRET=
CADDY_MERCURE_JWT_SECRET=
# Si la base ya existe en el volumen, tiene que ser la misma con la que se creó.
POSTGRES_PASSWORD=

# —— Symfony (lo que en desarrollo está en backend/.env.local) ——
APP_ENV=prod
DEFAULT_URI=https://fdn.transportesfuentedelnorte.com
CORS_ALLOW_ORIGIN=^https://fdn\.transportesfuentedelnorte\.com$
MAILER_DSN=

# SQL Server del legado
systemfdn_host=
systemfdn_port=
systemfdn_dbname=
systemfdn_user=
systemfdn_password=

# Facturación electrónica (Forcon, real)
FEL_CERTIFICADOR=
FEL_FORCON_URL=
FEL_FORCON_USUARIO=
FEL_FORCON_CLAVE=

# Notificaciones push del chat
PUSH_VAPID_PUBLICA=
PUSH_VAPID_PRIVADA=

# Pagos en línea
PAGO_PASARELA=
CYBERSOURCE_URL=
CYBERSOURCE_ORG_ID=

# Sincronización con el legado (ADR-042)
SINCRONIZACION_CLAVE=
SINCRONIZACION_URL_FDN=https://fdn.transportesfuentedelnorte.com
SINCRONIZACION_SOLO_TRAER=0
