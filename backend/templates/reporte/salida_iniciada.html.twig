{# Salida iniciada (ADR-045). Datos: ver ReportePdf::salidaIniciada (o = OcupacionAlIniciar, ficha). #}
{% extends 'reporte/_base.html.twig' %}
{% set titulo = 'Salida iniciada' %}

{% block ficha %}
<table class="ficha">
  <tr>
    <td style="width:40%"><div class="lbl">Ruta</div><div class="val">{{ ficha.ruta }}</div></td>
    <td style="width:30%"><div class="lbl">Inició</div><div class="val">{{ ficha.inicio }}</div></td>
    <td style="width:30%"><div class="lbl">Bus · Empresa</div><div class="val">{{ ficha.bus ?? '—' }} · {{ ficha.empresa ?? '—' }}</div></td>
  </tr>
</table>
<table class="cifras">
  <tr>
    <td style="width:16.66%"><div class="lbl">Ocupados</div><div class="n">{{ o.ocupados }}</div></td>
    <td style="width:16.66%"><div class="lbl">Con tramos intermedios</div><div class="n">{{ o.conIntermedias }}</div></td>
    <td style="width:16.66%"><div class="lbl">Libres</div><div class="n">{{ o.libres }}</div></td>
    <td style="width:16.66%"><div class="lbl">Estación</div><div class="n">{{ o.porCanal.estacion ?? 0 }}</div></td>
    <td style="width:16.66%"><div class="lbl">Agencia</div><div class="n">{{ o.porCanal.agencia ?? 0 }}</div></td>
    <td style="width:16.66%"><div class="lbl">Web</div><div class="n">{{ o.porCanal.web ?? 0 }}</div></td>
  </tr>
</table>
{% endblock %}

{% block cuerpo %}
<div class="seccion">Asientos por vendedor</div>
<table class="datos">
  <thead><tr>
    <th>Usuario</th>
    {% for etiqueta in columnas %}<th class="der">{{ etiqueta }}</th>{% endfor %}
  </tr></thead>
  <tbody>
  {% for f in o.filas %}
    <tr class="{{ loop.index is even ? 'par' : '' }}">
      <td>{{ f.usuario }}</td>
      {% for clave, etiqueta in columnas %}<td class="der num">{{ f.cuenta[clave] }}</td>{% endfor %}
    </tr>
  {% else %}
    <tr class="vacio"><td colspan="{{ columnas|length + 1 }}">No se vendió ningún boleto en esta salida.</td></tr>
  {% endfor %}
  </tbody>
  {% if o.filas|length > 0 %}
  <tfoot>
    <tr class="total">
      <td>Total</td>
      {% for clave, etiqueta in columnas %}<td class="der num">{{ o.totales[clave] }}</td>{% endfor %}
    </tr>
  </tfoot>
  {% endif %}
</table>
<p class="muted" style="margin-top:8px">Cada celda cuenta los asientos ocupados del vendedor en esa categoría; Anulados, sus boletos de esta salida que se anularon. Las categorías se solapan: el total es clase A + clase B.</p>
{% endblock %}
