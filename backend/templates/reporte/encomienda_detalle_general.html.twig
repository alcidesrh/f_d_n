{# Detalle general de encomiendas. Datos: d = DetalleGeneralEncomiendas, dinero. #}
{% extends 'reporte/_base.html.twig' %}
{% set titulo = 'Detalle general de encomiendas' %}

{% block ficha %}
<table class="ficha">
  <tr>
    <td style="width:20%"><div class="lbl">Fecha</div><div class="val">{{ d.rotulo }}</div></td>
    <td style="width:20%"><div class="lbl">Empresa</div><div class="val">{{ d.empresa ?? 'Todas' }}</div></td>
    <td style="width:22%"><div class="lbl">Origen</div><div class="val">{{ d.origen ?? 'Todos' }}</div></td>
    <td style="width:22%"><div class="lbl">Destino</div><div class="val">{{ d.destino ?? 'Todos' }}</div></td>
    <td style="width:16%"><div class="lbl">Encomiendas</div><div class="val">{{ d.totales.cantidad }}</div></td>
  </tr>
</table>
{% endblock %}

{% block cuerpo %}
{% for g in d.grupos %}
<div class="seccion">{{ g.dia|date('d/m/Y') }} · {{ g.origen }} → {{ g.destino }}</div>
<table class="datos">
  <thead><tr>
    <th>Código</th><th>Documento</th><th>Estado</th><th>Bus</th><th>Destinatario</th><th>Contenido</th><th class="der">Por cobrar</th><th class="der">Pagado</th>
  </tr></thead>
  <tbody>
  {% for l in g.filas %}
    <tr class="{{ loop.index is even ? 'par' : '' }}">
      <td class="num"><b>{{ l.codigo }}</b></td>
      <td>{{ l.documento }}</td>
      <td>{% if l.anulada %}<span class="etq etq-anul">Anulada</span>{% else %}{{ l.estadoEtiqueta }}{% endif %}</td>
      <td>{{ l.bus ?? '—' }}</td>
      <td>{{ l.destinatario }}</td>
      <td>{{ l.contenido }}</td>
      <td class="der num {{ l.anulada ? 'tachado' : '' }}">{{ dinero.num(l.esPorCobrar ? l.total : 0) }}</td>
      <td class="der num {{ l.anulada ? 'tachado' : '' }}">{{ dinero.num(l.esPorCobrar ? 0 : l.total) }}</td>
    </tr>
  {% endfor %}
  </tbody>
  <tfoot><tr class="subtotal"><td colspan="6">Cantidad: {{ g.totales.cantidad }} · Subtotal</td><td class="der num">{{ dinero.num(g.totales.porCobrar) }}</td><td class="der num">{{ dinero.num(g.totales.pagado) }}</td></tr></tfoot>
</table>
{% else %}
<table class="datos"><tr class="vacio"><td>No hay encomiendas con estos parámetros.</td></tr></table>
{% endfor %}
<table class="datos" style="margin-top:12px"><tfoot><tr class="total"><td>Cantidad: {{ d.totales.cantidad }}</td><td class="der">Por cobrar GTQ {{ dinero.num(d.totales.porCobrar) }}</td><td class="der">Pagado GTQ {{ dinero.num(d.totales.pagado) }}</td></tr></tfoot></table>
{% endblock %}
