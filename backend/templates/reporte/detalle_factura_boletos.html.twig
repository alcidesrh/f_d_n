{# Detalle de factura de boletos. Datos: ver ReportePdf::detalle (d = DetalleFacturaBoletos, dinero). #}
{% extends 'reporte/_base.html.twig' %}
{% set titulo = 'Detalle de factura de boletos' %}

{% block ficha %}
<table class="ficha">
  <tr>
    <td style="width:25%"><div class="lbl">Fecha de venta</div><div class="val">{{ d.rotulo }}</div></td>
    <td style="width:30%"><div class="lbl">Estación de venta</div><div class="val">{{ d.estacion ?? 'Todas las estaciones' }}</div></td>
    <td style="width:25%"><div class="lbl">Empresa</div><div class="val">{{ d.empresa ?? 'Todas' }}</div></td>
    <td style="width:20%"><div class="lbl">Boletos</div><div class="val">{{ d.cantidad }}</div></td>
  </tr>
</table>
{% endblock %}

{% block cuerpo %}
<table class="datos">
  <thead><tr>
    <th>Venta</th><th>Fecha y hora</th><th>Boleto</th><th>Factura</th><th>Número DTE</th><th>Serie DTE</th><th class="centro">Asiento</th><th>Origen</th><th>Destino</th><th>Descripción</th><th>Usuario</th><th class="der">Importe</th>
  </tr></thead>
  <tbody>
  {% for l in d.filas %}
    <tr class="{{ loop.index is even ? 'par' : '' }}">
      <td>{{ l.ventaId }}</td>
      <td class="num">{{ l.vendida|date('d/m/Y H:i:s') }}</td>
      <td>{{ l.boletoId }}</td>
      <td>{{ l.facturaId ?? '—' }}</td>
      <td class="num">{% if l.dte is not null %}{{ l.dte }}{% else %}<span class="etq {{ l.estadoFacturacion == 'pendiente' ? 'etq-pend' : '' }}">{{ l.estadoFacturacion == 'pendiente' ? 'Pendiente' : 'Sin factura' }}</span>{% endif %}</td>
      <td class="num">{{ l.serie ?? '' }}</td>
      <td class="centro"><b>{{ l.asiento }}</b></td>
      <td>{{ l.origen }}</td>
      <td>{{ l.destino }}</td>
      <td>{% if l.autorizacion %}Aut. {{ l.autorizacion }}{% endif %}{% if l.referenciaExterna %}{% if l.autorizacion %}<br>{% endif %}Ref. {{ l.referenciaExterna }}{% endif %}</td>
      <td>{{ l.usuario }}</td>
      <td class="der num">{{ l.moneda }} {{ dinero.num(l.cobrado) }}</td>
    </tr>
  {% else %}
    <tr class="vacio"><td colspan="12">No hay boletos facturados con estos parámetros.</td></tr>
  {% endfor %}
  </tbody>
  <tfoot>
  {% for moneda, t in d.totales %}
    <tr class="total"><td colspan="9">Cantidad: {{ t.cantidad }}</td><td colspan="2" class="der">Total {{ moneda }}</td><td class="der num">{{ dinero.num(t.total) }}</td></tr>
  {% endfor %}
  </tfoot>
</table>
{% endblock %}
