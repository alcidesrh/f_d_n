{# Estilos y encabezado comunes de los manifiestos (dompdf: CSS 2.1, sin flex/grid). Variables: m, usuario, generado, fecha, titulo. #}
<style>
  @page { margin: 30px 34px 44px; }
  body { font-family: "DejaVu Sans", sans-serif; font-size: 9px; color: #1f2937; }
  .muted { color: #6b7280; }
  table { border-collapse: collapse; }
  .banda { width: 100%; border-bottom: 3px solid #1e3a5f; padding-bottom: 8px; }
  .marca { font-size: 8px; letter-spacing: .14em; text-transform: uppercase; color: #6b7280; }
  .titulo { font-size: 19px; font-weight: bold; color: #1e3a5f; margin-top: 2px; }
  .meta td { font-size: 8px; color: #6b7280; text-align: right; padding: 0 0 1px 10px; }
  .meta td b { color: #1f2937; }
  .ficha { width: 100%; margin-top: 12px; background: #f3f6fa; border: 1px solid #d7e0ea; }
  .ficha td { padding: 6px 10px; vertical-align: top; width: 25%; }
  .lbl { font-size: 7px; letter-spacing: .06em; text-transform: uppercase; color: #6b7280; }
  .val { font-size: 10px; font-weight: bold; margin-top: 1px; }
  .cifras { width: 100%; margin-top: 8px; }
  .cifras td { width: 25%; padding: 5px 10px; border-left: 3px solid #2563eb; background: #eef4ff; }
  .cifras .n { font-size: 14px; font-weight: bold; color: #1e3a5f; }
  .datos { width: 100%; margin-top: 12px; }
  .datos th { background: #1e3a5f; color: #fff; font-size: 7.5px; letter-spacing: .05em; text-transform: uppercase; text-align: left; padding: 5px 6px; }
  .datos td { padding: 4px 6px; border-bottom: 1px solid #e5e9ef; vertical-align: top; }
  .datos tr { page-break-inside: avoid; }
  .datos tr.par td { background: #f8fafc; }
  .datos th.der, .der { text-align: right; }
  .datos th.centro, .centro { text-align: center; }
  .asiento { font-weight: bold; font-size: 10px; }
  .grupo td { background: #dbe6f4; color: #1e3a5f; font-weight: bold; font-size: 9px; padding: 5px 6px; border-bottom: 1px solid #b9cbe2; }
  .subtotal td { font-weight: bold; border-top: 1px solid #b9cbe2; background: #f3f6fa; }
  .total td { font-weight: bold; font-size: 10px; background: #1e3a5f; color: #fff; padding: 6px; }
  .obs td { font-size: 8px; color: #92400e; background: #fffbeb; border-bottom: 1px solid #e5e9ef; padding: 2px 6px 3px 24px; }
  .etq { font-size: 7px; font-weight: bold; padding: 1px 5px; border-radius: 6px; background: #e5e7eb; color: #374151; }
  .etq-sin { background: #fce7f3; color: #9d174d; }
</style>
<table class="banda"><tr>
  <td>
    <div class="marca">Transporte Fuente del Norte{% if m.empresa %} · {{ m.empresa }}{% endif %}</div>
    <div class="titulo">{{ titulo }}</div>
  </td>
  <td align="right">
    <table class="meta" align="right">
      <tr><td>Generado</td><td><b>{{ generado }}</b></td></tr>
      <tr><td>Usuario</td><td><b>{{ usuario }}</b></td></tr>
    </table>
  </td>
</tr></table>

<table class="ficha">
  <tr>
    <td><div class="lbl">Identificador</div><div class="val">{{ m.salidaId }}</div></td>
    <td><div class="lbl">Fecha de salida</div><div class="val">{{ fecha }}</div></td>
    <td><div class="lbl">Estación</div><div class="val">{{ m.estacion }}</div></td>
    <td><div class="lbl">Ruta</div><div class="val">{{ m.ruta }}</div></td>
  </tr>
  <tr>
    <td><div class="lbl">Empresa</div><div class="val">{{ m.empresa ?: '—' }}</div></td>
    <td><div class="lbl">Bus</div><div class="val">{{ m.bus ?? '—' }}</div></td>
    <td><div class="lbl">Piloto 1</div><div class="val">{{ m.pilotos[0] }}</div></td>
    <td><div class="lbl">Piloto 2</div><div class="val">{{ m.pilotos[1] }}</div></td>
  </tr>
</table>
